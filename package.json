{
  "name": "fusion-sql",
  "displayName": "Oracle Fusion SQL",
  "description": "Run SQL against Oracle Fusion Cloud through BI Publisher — no JDBC, no Java.",
  "version": "0.6.3",
  "publisher": "AleCyriaco",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AleCyriaco/oracle-fusion-sql-vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Data Science",
    "Other"
  ],
  "keywords": [
    "oracle",
    "fusion",
    "bi publisher",
    "sql",
    "erp",
    "bip",
    "fusion cloud",
    "jdbc"
  ],
  "activationEvents": [
    "onLanguage:sql",
    "onView:fusionSql.connections"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fusionSql",
          "title": "Oracle Fusion",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "fusionSql": [
        {
          "id": "fusionSql.connections",
          "name": "Connections"
        },
        {
          "id": "fusionSql.history",
          "name": "Query History"
        }
      ]
    },
    "commands": [
      {
        "command": "fusionSql.newQuery",
        "title": "New Query",
        "category": "Fusion",
        "icon": {
          "light": "media/icons/new-query-light.svg",
          "dark": "media/icons/new-query-dark.svg"
        }
      },
      {
        "command": "fusionSql.addConnection",
        "title": "New Connection",
        "category": "Fusion",
        "icon": {
          "light": "media/icons/add-connection-light.svg",
          "dark": "media/icons/add-connection-dark.svg"
        }
      },
      {
        "command": "fusionSql.importConnections",
        "title": "Import from connections.json",
        "category": "Fusion"
      },
      {
        "command": "fusionSql.editConnection",
        "title": "Edit Connection",
        "category": "Fusion",
        "icon": "$(edit)"
      },
      {
        "command": "fusionSql.duplicateConnection",
        "title": "Duplicate Connection",
        "category": "Fusion",
        "icon": "$(files)"
      },
      {
        "command": "fusionSql.removeConnection",
        "title": "Delete Connection",
        "category": "Fusion",
        "icon": "$(trash)"
      },
      {
        "command": "fusionSql.signIn",
        "title": "Sign In (SSO)",
        "category": "Fusion",
        "icon": "$(key)"
      },
      {
        "command": "fusionSql.signOut",
        "title": "Sign Out",
        "category": "Fusion"
      },
      {
        "command": "fusionSql.testConnection",
        "title": "Test Connection",
        "category": "Fusion",
        "icon": "$(plug)"
      },
      {
        "command": "fusionSql.setActiveConnection",
        "title": "Set as Active Connection",
        "category": "Fusion",
        "icon": "$(check)"
      },
      {
        "command": "fusionSql.runQuery",
        "title": "Run Query",
        "category": "Fusion",
        "icon": {
          "light": "media/icons/run-light.svg",
          "dark": "media/icons/run-dark.svg"
        }
      },
      {
        "command": "fusionSql.refresh",
        "title": "Refresh Connections",
        "category": "Fusion",
        "icon": {
          "light": "media/icons/refresh-light.svg",
          "dark": "media/icons/refresh-dark.svg"
        }
      },
      {
        "command": "fusionSql.showLog",
        "title": "Show Log",
        "category": "Fusion"
      },
      {
        "command": "fusionSql.generateQuery",
        "title": "Generate Query with AI",
        "category": "Fusion",
        "icon": {
          "light": "media/icons/generate-light.svg",
          "dark": "media/icons/generate-dark.svg"
        }
      },
      {
        "command": "fusionSql.setAiKey",
        "title": "Add AI Helper (API Key)",
        "category": "Fusion"
      },
      {
        "command": "fusionSql.clearAiKey",
        "title": "Remove Stored AI API Keys",
        "category": "Fusion"
      },
      {
        "command": "fusionSql.openHistoryEntry",
        "title": "Open in Editor",
        "category": "Fusion",
        "icon": "$(go-to-file)"
      },
      {
        "command": "fusionSql.runHistoryEntry",
        "title": "Run Again",
        "category": "Fusion",
        "icon": "$(play)"
      },
      {
        "command": "fusionSql.copyHistoryEntry",
        "title": "Copy SQL",
        "category": "Fusion",
        "icon": "$(copy)"
      },
      {
        "command": "fusionSql.deleteHistoryEntry",
        "title": "Remove from History",
        "category": "Fusion",
        "icon": "$(close)"
      },
      {
        "command": "fusionSql.clearHistory",
        "title": "Clear Query History",
        "category": "Fusion",
        "icon": "$(clear-all)"
      },
      {
        "command": "fusionSql.selectAiProvider",
        "title": "Select AI Provider",
        "category": "Fusion",
        "icon": "$(server)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "fusionSql.addConnection",
          "when": "view == fusionSql.connections",
          "group": "navigation@1"
        },
        {
          "command": "fusionSql.newQuery",
          "when": "view == fusionSql.connections",
          "group": "navigation@2"
        },
        {
          "command": "fusionSql.generateQuery",
          "when": "view == fusionSql.connections",
          "group": "navigation@3"
        },
        {
          "command": "fusionSql.refresh",
          "when": "view == fusionSql.connections",
          "group": "navigation@4"
        },
        {
          "command": "fusionSql.importConnections",
          "when": "view == fusionSql.connections",
          "group": "1_import@1"
        },
        {
          "command": "fusionSql.setAiKey",
          "when": "view == fusionSql.connections",
          "group": "2_ai@1"
        },
        {
          "command": "fusionSql.selectAiProvider",
          "when": "view == fusionSql.connections",
          "group": "2_ai@2"
        },
        {
          "command": "fusionSql.clearAiKey",
          "when": "view == fusionSql.connections",
          "group": "2_ai@3"
        },
        {
          "command": "fusionSql.showLog",
          "when": "view == fusionSql.connections",
          "group": "3_help@1"
        },
        {
          "command": "fusionSql.generateQuery",
          "when": "view == fusionSql.history",
          "group": "navigation@1"
        },
        {
          "command": "fusionSql.clearHistory",
          "when": "view == fusionSql.history",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "fusionSql.testConnection",
          "when": "view == fusionSql.connections && viewItem =~ /^connection/",
          "group": "inline@1"
        },
        {
          "command": "fusionSql.editConnection",
          "when": "view == fusionSql.connections && viewItem =~ /^connection/",
          "group": "inline@2"
        },
        {
          "command": "fusionSql.setActiveConnection",
          "when": "view == fusionSql.connections && viewItem =~ /^connection/",
          "group": "1_use@1"
        },
        {
          "command": "fusionSql.testConnection",
          "when": "view == fusionSql.connections && viewItem =~ /^connection/",
          "group": "1_use@2"
        },
        {
          "command": "fusionSql.signIn",
          "when": "view == fusionSql.connections && viewItem == connection.sso",
          "group": "2_auth@1"
        },
        {
          "command": "fusionSql.signOut",
          "when": "view == fusionSql.connections && viewItem == connection.sso",
          "group": "2_auth@2"
        },
        {
          "command": "fusionSql.editConnection",
          "when": "view == fusionSql.connections && viewItem =~ /^connection/",
          "group": "3_edit@1"
        },
        {
          "command": "fusionSql.duplicateConnection",
          "when": "view == fusionSql.connections && viewItem =~ /^connection/",
          "group": "3_edit@2"
        },
        {
          "command": "fusionSql.removeConnection",
          "when": "view == fusionSql.connections && viewItem =~ /^connection/",
          "group": "3_edit@3"
        },
        {
          "command": "fusionSql.runHistoryEntry",
          "when": "view == fusionSql.history && viewItem == history",
          "group": "inline@1"
        },
        {
          "command": "fusionSql.copyHistoryEntry",
          "when": "view == fusionSql.history && viewItem == history",
          "group": "inline@2"
        },
        {
          "command": "fusionSql.openHistoryEntry",
          "when": "view == fusionSql.history && viewItem == history",
          "group": "1_use@1"
        },
        {
          "command": "fusionSql.deleteHistoryEntry",
          "when": "view == fusionSql.history && viewItem == history",
          "group": "2_edit@1"
        }
      ],
      "editor/title": [
        {
          "command": "fusionSql.runQuery",
          "when": "editorLangId == sql",
          "group": "navigation"
        },
        {
          "command": "fusionSql.generateQuery",
          "when": "editorLangId == sql",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "fusionSql.runQuery",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == sql"
      }
    ],
    "configuration": {
      "title": "Oracle Fusion SQL",
      "properties": {
        "fusionSql.connections": {
          "type": "array",
          "default": [],
          "description": "Fusion environments. Passwords and tokens are never stored here — they live in the OS keychain.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "url"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "description": "https://<pod>.fa.<region>.oraclecloud.com"
              },
              "authMode": {
                "type": "string",
                "enum": [
                  "basic",
                  "sso"
                ],
                "default": "basic"
              },
              "user": {
                "type": "string",
                "description": "Basic auth only."
              },
              "reportPath": {
                "type": "string",
                "description": "Pre-deployed proxy report. Required for SSO."
              },
              "oauth": {
                "type": "object",
                "properties": {
                  "authorizeUrl": {
                    "type": "string"
                  },
                  "tokenUrl": {
                    "type": "string"
                  },
                  "clientId": {
                    "type": "string"
                  },
                  "scope": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "fusionSql.pageSize": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "maximum": 5000,
          "description": "Rows fetched per page."
        },
        "fusionSql.timeoutSeconds": {
          "type": "number",
          "default": 120,
          "description": "HTTP timeout in seconds."
        },
        "fusionSql.ai.provider": {
          "type": "string",
          "enum": [
            "anthropic",
            "openai",
            "xai",
            "deepseek",
            "compatible"
          ],
          "enumDescriptions": [
            "Anthropic Messages API (Claude).",
            "OpenAI chat completions.",
            "xAI (Grok) — api.x.ai.",
            "DeepSeek — api.deepseek.com.",
            "Any other endpoint that speaks the OpenAI chat-completions shape (Azure OpenAI, OpenRouter, Ollama, vLLM). Set fusionSql.ai.baseUrl."
          ],
          "default": "anthropic",
          "description": "Which provider generates queries. API keys are stored in the OS keychain, never here."
        },
        "fusionSql.ai.model": {
          "type": "string",
          "default": "",
          "description": "Model id. Blank uses the provider default: claude-opus-5, gpt-5.6-sol, grok-4.6, deepseek-v4-pro. Required for a compatible endpoint."
        },
        "fusionSql.ai.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL for the \"compatible\" provider, e.g. http://localhost:11434/v1. Ignored for the named providers, which use their own endpoint."
        },
        "fusionSql.ai.timeoutSeconds": {
          "type": "number",
          "default": 90,
          "description": "How long to wait for the model."
        },
        "fusionSql.ai.validate": {
          "type": "boolean",
          "default": true,
          "description": "Run a generated statement against the active connection before handing it over, and send any database error back to the model to be corrected. Costs one round trip per attempt."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "fusionSql.connections",
        "contents": "No Fusion connections yet.\n[New Connection](command:fusionSql.addConnection)\nAlready using the fusion-query MCP server? Bring its environments across.\n[Import from connections.json](command:fusionSql.importConnections)"
      },
      {
        "view": "fusionSql.history",
        "when": "!fusionSql.hasAiKey",
        "contents": "Queries you run appear here.\n\nLet a language model draft them for you — describe what you need in plain words and get Oracle SQL written for Fusion. Bring a key from Anthropic, OpenAI, or any OpenAI-compatible endpoint; it is kept in the OS keychain.\n[Add AI Helper (API Key)](command:fusionSql.setAiKey)"
      },
      {
        "view": "fusionSql.history",
        "when": "fusionSql.hasAiKey",
        "contents": "Queries you run appear here.\n[Generate Query with AI](command:fusionSql.generateQuery)"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node --test out/test/*.test.js",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.0"
  },
  "bugs": {
    "url": "https://github.com/AleCyriaco/oracle-fusion-sql-vscode/issues"
  },
  "homepage": "https://github.com/AleCyriaco/oracle-fusion-sql-vscode#readme",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1C2536",
    "theme": "dark"
  },
  "qna": "marketplace",
  "badges": [],
  "extensionKind": [
    "workspace",
    "ui"
  ]
}
